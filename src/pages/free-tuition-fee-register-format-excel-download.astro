---
// ── SEO METADATA ──────────────────────────────────────────────
const title =
  "Tuition Fee Register Format in Excel Download — Free Template for Private Teachers";
const description =
  "Free tuition fee register format in Excel for private tuition teachers. Track monthly fees, pending dues & collections. Download & start today.";
const canonicalUrl =
  "https://blog.studentkhata.online/free-tuition-fee-register-format-excel-download";

// ── LINKS ──────────────────────────────────────────────────────
const excelDownloadUrl = "/downloads/tuition-fee-register-format.xlsx";
const loginUrl =
  "https://studentkhata.online/login?utm_source=blog&utm_medium=article&utm_campaign=fee_register_excel";
const homeUrl =
  "https://studentkhata.online?utm_source=blog&utm_medium=article&utm_campaign=fee_register_excel";

// ── INTERNAL LINK PLACEHOLDERS ─────────────────────────────────
const receiptLink    = "/fee-receipt-format-for-tuition-teachers";
const attendanceLink = "/attendance-register-format-for-tuition-classes";
const smsLink        = "/student-management-system-for-teachers";

// ── IMAGES ────────────────────────────────────────────────────
const previewImg = "/images/tuition-fee-register-excel.webp";
const ogImg      = "https://blog.studentkhata.online/images/tuition-fee-register-excel.webp";

// ── ARTICLE META ───────────────────────────────────────────────
const publishDate        = "2025-05-01";
const modifiedDate       = "2025-05-15";
const publishDateDisplay = "May 2025";
const readTime           = "7 min read";

// ── FAQ DATA ───────────────────────────────────────────────────
const faqItems = [
  {
    question: "Is Excel good enough for managing coaching class fees?",
    answer:
      "Yes, absolutely — especially for smaller batches. Excel is free, familiar, and works well for tracking payments. The main limitation is that it is fully manual: you update it yourself, remember to check it, and there are no automatic reminders or receipts. As long as you are consistent, it does the job.",
  },
  {
    question: "How do I track which students have pending fees in Excel?",
    answer:
      "In this Excel template, a formula compares the monthly fee with the payment entered. If paid in full, it shows Paid. If not, it shows Pending. You can filter by pending status to get a quick list at any time.",
  },
  {
    question: "What is the best way to manage tuition fees for private teachers?",
    answer:
      "For small batches under 20 students, a student fee tracking Excel sheet is perfectly fine. Once you have more students or multiple batches, a dedicated tool like StudentKhata makes more sense — it handles reminders, attendance, and receipts automatically, saving 2 to 3 hours every month.",
  },
  {
    question: "Can I use this monthly fee collection format in Google Sheets?",
    answer:
      "Yes. The .xlsx format works in Google Sheets. Just upload the file to Google Drive and open it — all formulas and formatting will work correctly.",
  },
  {
    question: "How do I remind parents about pending fees without being awkward?",
    answer:
      "The most effective approach is a short, polite WhatsApp message sent on a fixed day each month. Something like: Namaste, this is a friendly reminder that your child's tuition fee for this month is pending. Kindly arrange payment at your earliest convenience. Keeping it consistent and scheduled makes it feel professional rather than awkward.",
  },
];

// ── SCHEMAS ────────────────────────────────────────────────────
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  image: ogImg,
  author: { "@type": "Organization", name: "StudentKhata", url: homeUrl },
  publisher: {
    "@type": "Organization",
    name: "StudentKhata",
    url: homeUrl,
    logo: {
      "@type": "ImageObject",
      url: "https://blog.studentkhata.online/images/logo.png",
    },
  },
  datePublished: publishDate,
  dateModified: modifiedDate,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://blog.studentkhata.online",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Templates",
      item: "https://blog.studentkhata.online/templates",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Tuition Fee Register Format in Excel",
      item: canonicalUrl,
    },
  ],
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to use a tuition fee register format in Excel",
  description:
    "Step-by-step guide to setting up and using an Excel fee register for private tuition teachers.",
  supply: [{ "@type": "HowToSupply", name: "Free Excel fee register template" }],
  tool: [{ "@type": "HowToTool", name: "Microsoft Excel or Google Sheets" }],
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "Open the file and save a copy with your batch name",
      text: "Save as something like Class-10-Maths-2025-26.xlsx so each year or batch has its own file.",
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "Enter student names, class, and monthly fee",
      text: "Column B is student name, Column C is class or batch, Column D is the monthly fee amount.",
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "Record each payment in the correct month column",
      text: "When a student pays, type the amount in their row under the correct month. Status updates to Paid automatically.",
    },
    {
      "@type": "HowToStep",
      position: 4,
      name: "Update attendance in Sheet 2 using P, A, or L",
      text: "Type P for Present, A for Absent, or L for Leave each day. Colors update automatically.",
    },
    {
      "@type": "HowToStep",
      position: 5,
      name: "Review the Pending Fees sheet at the start of each month",
      text: "Copy students with dues, enter months pending, and add a note after contacting parents.",
    },
  ],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content="StudentKhata" />
    <meta name="theme-color" content="#1a1a1a" />

    <meta property="og:type"        content="article" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:site_name"   content="StudentKhata Blog" />
    <meta property="og:image"       content={ogImg} />
    <meta property="og:image:alt"   content="Tuition fee register format in Excel for private tuition teachers" />
    <meta property="article:published_time" content={publishDate} />
    <meta property="article:modified_time"  content={modifiedDate} />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImg} />

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      /* ── RESET ── */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

      /* ── TOKENS ── */
      :root {
        --ink:          #1a1a1a;
        --ink-mid:      #3d3d3d;
        --ink-soft:     #6b6b6b;
        --ink-muted:    #9a9a9a;
        --paper:        #fdfcf9;
        --paper-warm:   #f7f4ee;
        --paper-mid:    #ede9e0;
        --border:       #ddd9d0;
        --teal:         #0d9488;
        --teal-dark:    #0f766e;
        --teal-pale:    #f0fdfa;
        --teal-border:  #99f6e4;
        --amber:        #d97706;
        --amber-pale:   #fffbeb;
        --amber-light:  #fef3c7;
        --red:          #dc2626;
        --red-pale:     #fef2f2;
        --red-border:   #fecaca;
        --green:        #16a34a;
        --green-pale:   #f0fdf4;
        --green-border: #bbf7d0;
        --serif:        'Merriweather', Georgia, serif;
        --sans:         'Source Sans 3', system-ui, -apple-system, sans-serif;
        --r-sm:         6px;
        --r-md:         10px;
        --r-lg:         14px;
      }

      /* ── BASE ── */
      body {
        font-family: var(--sans);
        background: var(--paper);
        color: var(--ink);
        font-size: 16px;
        line-height: 1.75;
        -webkit-font-smoothing: antialiased;
      }
      img { max-width: 100%; height: auto; display: block; }
      a { color: var(--teal); }
      a:hover { text-decoration: underline; }

      /* ── HEADER ── */
      .site-header {
        position: sticky; top: 0; z-index: 50;
        background: rgba(253,252,249,.96);
        border-bottom: 1px solid var(--border);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        padding: .75rem 1.25rem;
        display: flex; align-items: center;
        justify-content: space-between; gap: .75rem;
      }
      .brand {
        display: flex; align-items: center; gap: .5rem;
        text-decoration: none !important; color: var(--ink);
        font-family: var(--serif); font-weight: 700; font-size: .95rem;
      }
      .brand-mark {
        width: 30px; height: 30px; background: var(--ink); color: #f59e0b;
        border-radius: 7px; display: grid; place-items: center;
        font-size: .68rem; font-weight: 900; flex-shrink: 0;
      }
      .header-cta {
        background: var(--teal); color: #fff !important;
        text-decoration: none !important;
        padding: .44rem .88rem; border-radius: var(--r-sm);
        font-size: .82rem; font-weight: 600; white-space: nowrap;
        transition: background .15s;
      }
      .header-cta:hover { background: var(--teal-dark); }

      /* ── BREADCRUMB ── */
      .breadcrumb {
        max-width: 720px; margin: 0 auto;
        padding: .6rem 1.25rem 0;
        font-size: .75rem; color: var(--ink-muted);
        display: flex; align-items: center; gap: .3rem; flex-wrap: wrap;
      }
      .breadcrumb a { color: var(--ink-muted); text-decoration: none; }
      .breadcrumb a:hover { color: var(--teal); }
      .breadcrumb .sep { opacity: .45; }
      .breadcrumb .current { color: var(--ink-soft); }

      /* ── LAYOUT ── */
      .article-wrap {
        max-width: 720px; margin: 0 auto;
        padding: 0 1.25rem 5rem;
      }

      /* ── ARTICLE HEADER ── */
      .article-header {
        padding: 2.25rem 0 1.6rem;
        border-bottom: 2px solid var(--ink);
        margin-bottom: 1.85rem;
      }
      .article-category {
        display: inline-flex; align-items: center; gap: .35rem;
        font-size: .72rem; font-weight: 700; letter-spacing: .1em;
        text-transform: uppercase; color: var(--teal);
        margin-bottom: .8rem; text-decoration: none !important;
      }
      .article-category::before {
        content: ''; display: inline-block;
        width: 18px; height: 2px; background: var(--teal);
      }
      .article-title {
        font-family: var(--serif);
        font-size: clamp(1.55rem, 5vw, 2.5rem);
        font-weight: 900; line-height: 1.2;
        letter-spacing: -.02em; color: var(--ink); margin-bottom: .85rem;
      }
      .article-deck {
        font-size: clamp(.97rem, 2.5vw, 1.08rem); color: var(--ink-mid);
        line-height: 1.6; font-family: var(--serif); font-style: italic;
        margin-bottom: 1.15rem;
      }
      .article-meta {
        display: flex; align-items: center;
        gap: .6rem 1rem; font-size: .78rem;
        color: var(--ink-muted); flex-wrap: wrap;
      }
      .article-meta span { display: flex; align-items: center; gap: .25rem; }

      /* ── DOWNLOAD BOX ── */
      .download-box {
        background: var(--ink); color: white;
        border-radius: var(--r-lg);
        padding: 1.2rem 1.4rem; margin: 1.6rem 0;
        display: flex; align-items: center;
        justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      }
      .download-box-text strong { display: block; font-size: .95rem; font-weight: 700; margin-bottom: .15rem; }
      .download-box-text span  { font-size: .8rem; color: rgba(255,255,255,.58); }

      /* ── PREVIEW IMAGE ── */
      .preview-img-wrap {
        margin: .4rem 0 1.6rem;
        border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden;
      }
      .preview-img-wrap img { border-radius: 0; width: 100%; }
      .preview-img-caption {
        padding: .45rem .8rem; font-size: .75rem; color: var(--ink-muted);
        background: var(--paper-warm); border-top: 1px solid var(--border); text-align: center;
      }

      /* ── BUTTONS ── */
      .btn-download {
        display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
        background: #f59e0b; color: var(--ink) !important;
        text-decoration: none !important;
        padding: .68rem 1.2rem; border-radius: var(--r-sm);
        font-weight: 700; font-size: .87rem; white-space: nowrap;
        transition: transform .15s, box-shadow .15s;
        box-shadow: 0 3px 10px rgba(245,158,11,.38); flex-shrink: 0;
      }
      .btn-download:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(245,158,11,.5); }

      .btn-dark {
        display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
        background: var(--ink); color: white !important;
        text-decoration: none !important;
        padding: .82rem 1.45rem; border-radius: var(--r-md);
        font-size: .94rem; font-weight: 700;
        transition: transform .15s, box-shadow .15s;
        box-shadow: 0 4px 14px rgba(26,26,26,.2);
      }
      .btn-dark:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(26,26,26,.28); }
      .btn-full { width: 100%; }

      .btn-teal {
        display: inline-flex; align-items: center; justify-content: center; gap: .35rem;
        background: var(--teal); color: white !important;
        text-decoration: none !important;
        padding: .58rem 1.1rem; border-radius: var(--r-sm);
        font-size: .86rem; font-weight: 600;
        transition: background .15s; flex-shrink: 0; white-space: nowrap;
      }
      .btn-teal:hover { background: var(--teal-dark); }

      .btn-amber {
        display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
        background: #f59e0b; color: var(--ink) !important;
        text-decoration: none !important;
        padding: .78rem 1.45rem; border-radius: var(--r-sm);
        font-size: .94rem; font-weight: 800;
        transition: transform .15s, box-shadow .15s;
        box-shadow: 0 4px 14px rgba(245,158,11,.35);
      }
      .btn-amber:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(245,158,11,.5); }

      /* ── TABLE OF CONTENTS ── */
      .toc {
        background: var(--paper-warm); border: 1px solid var(--border);
        border-radius: var(--r-md); padding: 1.05rem 1.3rem; margin: 1.6rem 0; font-size: .89rem;
      }
      .toc-title {
        font-family: var(--serif); font-weight: 700; font-size: .76rem;
        text-transform: uppercase; letter-spacing: .08em; color: var(--ink-soft); margin-bottom: .6rem;
      }
      .toc ol { margin: 0; padding-left: 1.1rem; color: var(--ink-mid); }
      .toc li { margin-bottom: .28rem; }
      .toc a { color: var(--ink-mid); font-weight: 500; text-decoration: none; }
      .toc a:hover { color: var(--teal); text-decoration: underline; }

      /* ── PROSE ── */
      .prose h2 {
        font-family: var(--serif);
        font-size: clamp(1.18rem, 3.5vw, 1.52rem);
        font-weight: 900; color: var(--ink); line-height: 1.25;
        margin: 2.1rem 0 .7rem; letter-spacing: -.02em;
        scroll-margin-top: 70px;
      }
      .prose h3 {
        font-family: var(--serif); font-size: clamp(.97rem, 2.5vw, 1.08rem);
        font-weight: 700; color: var(--ink); margin: 1.5rem 0 .45rem;
      }
      .prose p { color: var(--ink-mid); margin-bottom: 1.05rem; font-size: 1rem; line-height: 1.8; }
      .prose p:last-child { margin-bottom: 0; }
      .prose strong { color: var(--ink); font-weight: 700; }
      .prose ul, .prose ol { margin: .6rem 0 1.05rem 1.3rem; color: var(--ink-mid); }
      .prose li { margin-bottom: .38rem; line-height: 1.7; font-size: 1rem; }
      .prose blockquote {
        border-left: 3px solid var(--ink); padding: .5rem 0 .5rem 1.05rem;
        margin: 1.4rem 0; font-family: var(--serif); font-style: italic;
        font-size: clamp(1rem, 2.5vw, 1.08rem); color: var(--ink-mid);
      }

      /* ── CALLOUT ── */
      .callout {
        border-radius: var(--r-md); padding: .95rem 1.1rem;
        margin: 1.25rem 0; font-size: .94rem; line-height: 1.65;
      }
      .callout strong { font-weight: 700; display: block; margin-bottom: .18rem; }
      .callout-amber { background: var(--amber-pale); border-left: 4px solid var(--amber); color: #78350f; }
      .callout-teal  { background: var(--teal-pale);  border-left: 4px solid var(--teal);  color: #134e4a; }

      /* ── PULL QUOTE ── */
      .pull-quote {
        border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink);
        padding: 1rem 0; margin: 1.6rem 0;
        font-family: var(--serif); font-size: clamp(1.02rem, 3vw, 1.2rem);
        font-style: italic; color: var(--ink); line-height: 1.5; text-align: center;
      }

      /* ── DIVIDER ── */
      .section-rule { border: none; border-top: 1px solid var(--border); margin: 2.1rem 0; }

      /* ── STEP LIST ── */
      .step-list { display: flex; flex-direction: column; gap: .75rem; margin: 1.05rem 0; }
      .step-item { display: flex; gap: .8rem; align-items: flex-start; }
      .step-num {
        width: 26px; height: 26px; min-width: 26px;
        background: var(--ink); color: white; border-radius: 50%;
        display: grid; place-items: center;
        font-size: .74rem; font-weight: 700; margin-top: 2px;
      }
      .step-body strong { display: block; font-size: .94rem; color: var(--ink); margin-bottom: .13rem; }
      .step-body p { font-size: .88rem; color: var(--ink-soft); margin: 0; line-height: 1.6; }

      /* ── SAMPLE TABLE ── */
      .tbl-wrap {
        overflow-x: auto; border: 1px solid var(--border);
        border-radius: var(--r-md); margin: 1.05rem 0;
        -webkit-overflow-scrolling: touch;
      }
      .tbl { width: 100%; min-width: 480px; border-collapse: collapse; font-size: .84rem; }
      .tbl thead tr { background: var(--paper-mid); }
      .tbl th {
        padding: .58rem .78rem; text-align: left; font-size: .7rem;
        font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
        color: var(--ink-soft); border-bottom: 2px solid var(--border); white-space: nowrap;
      }
      .tbl td {
        padding: .58rem .78rem; border-bottom: 1px solid var(--border);
        color: var(--ink-mid); white-space: nowrap; vertical-align: top;
      }
      .tbl tbody tr:last-child td { border-bottom: none; }
      .tbl tbody tr:nth-child(even) { background: var(--paper-warm); }
      .tbl tbody tr:hover { background: var(--paper-mid); }

      /* ── BADGES ── */
      .tag-paid {
        background: var(--green-pale); color: var(--green);
        border: 1px solid var(--green-border); border-radius: 4px;
        padding: .08rem .4rem; font-size: .72rem; font-weight: 700;
      }
      .tag-pending {
        background: var(--red-pale); color: var(--red);
        border: 1px solid var(--red-border); border-radius: 4px;
        padding: .08rem .4rem; font-size: .72rem; font-weight: 700;
      }
      .badge-yes {
        background: var(--green-pale); color: var(--green);
        border: 1px solid var(--green-border); border-radius: 4px;
        padding: .08rem .42rem; font-size: .73rem; font-weight: 700;
        display: inline-flex; align-items: center; gap: .2rem;
      }
      .badge-no {
        background: var(--red-pale); color: var(--red);
        border: 1px solid var(--red-border); border-radius: 4px;
        padding: .08rem .42rem; font-size: .73rem; font-weight: 700;
        display: inline-flex; align-items: center; gap: .2rem;
      }
      .badge-partial {
        background: var(--amber-light); color: #92400e;
        border: 1px solid #fde68a; border-radius: 4px;
        padding: .08rem .42rem; font-size: .73rem; font-weight: 700;
        display: inline-flex; align-items: center; gap: .2rem;
      }

      /* ── INLINE CTA ── */
      .inline-cta {
        border: 1px solid var(--border); border-radius: var(--r-md);
        padding: 1.05rem 1.25rem; margin: 1.6rem 0;
        display: flex; gap: .9rem; align-items: center; flex-wrap: wrap;
      }
      .inline-cta-text { flex: 1; min-width: 175px; }
      .inline-cta-text strong { display: block; font-size: .92rem; color: var(--ink); margin-bottom: .13rem; }
      .inline-cta-text p { font-size: .82rem; color: var(--ink-soft); margin: 0; line-height: 1.5; }

      /* ── SK BOX ── */
      .sk-box { background: var(--ink); border-radius: var(--r-lg); padding: 1.65rem 1.4rem; margin: 2.1rem 0; }
      .sk-box-header { display: flex; align-items: flex-start; gap: .85rem; margin-bottom: 1.05rem; }
      .sk-logo-mark {
        width: 38px; height: 38px; min-width: 38px;
        background: #f59e0b; border-radius: 8px;
        display: grid; place-items: center;
        font-family: var(--serif); font-weight: 900; font-size: .8rem; color: var(--ink);
      }
      .sk-box-title { font-family: var(--serif); font-size: 1.1rem; font-weight: 900; color: white; line-height: 1.25; }
      .sk-box-sub { font-size: .8rem; color: rgba(255,255,255,.55); margin-top: .18rem; }
      .sk-features {
