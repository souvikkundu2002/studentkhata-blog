    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="StudentKhata Blog" />
    <meta property="og:image" content="https://blog.studentkhata.online/images/tuition-fee-register-excel.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://blog.studentkhata.online/images/tuition-fee-register-excel.webp" />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
    /* ── RESET ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

    /* ── TOKENS ── */
    :root {
      --ink:        #1a1a1a;
      --ink-mid:    #3d3d3d;
      --ink-soft:   #6b6b6b;
      --ink-muted:  #9a9a9a;
      --paper:      #fdfcf9;
      --paper-warm: #f7f4ee;
      --paper-mid:  #ede9e0;
      --border:     #ddd9d0;
      --teal:       #0d9488;
      --teal-dark:  #0f766e;
      --teal-pale:  #f0fdfa;
      --amber:      #d97706;
      --amber-pale: #fffbeb;
      --amber-light:#fef3c7;
      --red:        #dc2626;
      --red-pale:   #fef2f2;
      --green:      #16a34a;
      --green-pale: #f0fdf4;
      --serif:      'Merriweather', Georgia, 'Times New Roman', serif;
      --sans:       'Source Sans 3', system-ui, sans-serif;
    }

    /* ── BASE ── */
    body {
      font-family: var(--sans);
      background: var(--paper);
      color: var(--ink);
      font-size: 17px;
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
    }

    img { max-width: 100%; height: auto; display: block; }
    a { color: var(--teal); }
    a:hover { text-decoration: underline; }

    /* ── SITE HEADER ── */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(253,252,249,0.96);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(10px);
      padding: 0.8rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      text-decoration: none;
      color: var(--ink);
      font-family: var(--serif);
      font-weight: 700;
      font-size: 1rem;
    }

    .brand-mark {
      width: 32px;
      height: 32px;
      background: var(--ink);
      color: #f59e0b;
      border-radius: 8px;
      display: grid;
      place-items: center;
      font-size: 0.7rem;
      font-weight: 900;
      flex-shrink: 0;
    }

    .header-cta {
      background: var(--teal);
      color: #fff !important;
      text-decoration: none !important;
      padding: 0.48rem 1rem;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      transition: background 0.15s;
      white-space: nowrap;
    }
    .header-cta:hover { background: var(--teal-dark); }

    /* ── ARTICLE LAYOUT ── */
    .article-wrap {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 1.5rem 5rem;
    }

    /* ── ARTICLE HEADER ── */
    .article-header {
      padding: 3rem 0 2rem;
      border-bottom: 2px solid var(--ink);
      margin-bottom: 2.5rem;
    }

    .article-category {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--teal);
      margin-bottom: 1rem;
    }

    .article-category::before {
      content: '';
      display: inline-block;
      width: 20px;
      height: 2px;
      background: var(--teal);
    }

    .article-title {
      font-family: var(--serif);
      font-size: clamp(1.75rem, 5vw, 2.6rem);
      font-weight: 900;
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin-bottom: 1rem;
    }

    .article-deck {
      font-size: 1.15rem;
      color: var(--ink-mid);
      line-height: 1.6;
      font-family: var(--serif);
      font-style: italic;
      margin-bottom: 1.5rem;
    }

    .article-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 0.82rem;
      color: var(--ink-muted);
      flex-wrap: wrap;
    }

    .article-meta span { display: flex; align-items: center; gap: 0.3rem; }

    /* ── DOWNLOAD BOX (early, high converting) ── */
    .download-box {
      background: var(--ink);
      color: white;
      border-radius: 12px;
      padding: 1.5rem 1.75rem;
      margin: 2rem 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .download-box-text strong {
      display: block;
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 0.2rem;
    }

    .download-box-text span {
      font-size: 0.85rem;
      color: rgba(255,255,255,0.65);
    }

    .btn-download {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #f59e0b;
      color: var(--ink) !important;
      text-decoration: none !important;
      padding: 0.7rem 1.35rem;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.9rem;
      white-space: nowrap;
      transition: transform 0.15s, box-shadow 0.15s;
      box-shadow: 0 3px 10px rgba(245,158,11,0.4);
      flex-shrink: 0;
    }
    .btn-download:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(245,158,11,0.5);
    }

    /* ── PROSE ── */
    .prose h2 {
      font-family: var(--serif);
      font-size: clamp(1.3rem, 3vw, 1.6rem);
      font-weight: 900;
      color: var(--ink);
      line-height: 1.25;
      margin: 2.5rem 0 0.85rem;
      letter-spacing: -0.02em;
    }

    .prose h3 {
      font-family: var(--serif);
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--ink);
      margin: 1.75rem 0 0.6rem;
    }

    .prose p {
      color: var(--ink-mid);
      margin-bottom: 1.2rem;
      font-size: 1rem;
      line-height: 1.8;
    }

    .prose p:last-child { margin-bottom: 0; }

    .prose strong { color: var(--ink); font-weight: 700; }

    .prose ul, .prose ol {
      margin: 0.75rem 0 1.2rem 1.5rem;
      color: var(--ink-mid);
    }

    .prose li {
      margin-bottom: 0.45rem;
      line-height: 1.7;
    }

    .prose blockquote {
      border-left: 3px solid var(--ink);
      padding: 0.6rem 0 0.6rem 1.25rem;
      margin: 1.75rem 0;
      font-family: var(--serif);
      font-style: italic;
      font-size: 1.1rem;
      color: var(--ink-mid);
    }

    /* ── CALLOUT BOXES ── */
    .callout {
      border-radius: 10px;
      padding: 1.1rem 1.25rem;
      margin: 1.5rem 0;
      font-size: 0.97rem;
    }

    .callout-amber {
      background: var(--amber-pale);
      border-left: 4px solid var(--amber);
      color: #78350f;
    }

    .callout-teal {
      background: var(--teal-pale);
      border-left: 4px solid var(--teal);
      color: #134e4a;
    }

    .callout-red {
      background: var(--red-pale);
      border-left: 4px solid var(--red);
      color: #7f1d1d;
    }

    .callout strong { font-weight: 700; display: block; margin-bottom: 0.2rem; }

    /* ── PULL QUOTE ── */
    .pull-quote {
      border-top: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
      padding: 1.25rem 0;
      margin: 2rem 0;
      font-family: var(--serif);
      font-size: clamp(1.15rem, 3vw, 1.35rem);
      font-style: italic;
      color: var(--ink);
      line-height: 1.5;
      text-align: center;
    }

    /* ── SECTION DIVIDER ── */
    .section-rule {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2.5rem 0;
    }

    /* ── TABLE OF CONTENTS ── */
    .toc {
      background: var(--paper-warm);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      margin: 1.75rem 0;
      font-size: 0.92rem;
    }

    .toc-title {
      font-family: var(--serif);
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ink-soft);
      margin-bottom: 0.75rem;
    }

    .toc ol {
      margin: 0;
      padding-left: 1.25rem;
      color: var(--ink-mid);
    }

    .toc li { margin-bottom: 0.35rem; }
    .toc a { color: var(--ink-mid); font-weight: 500; }
    .toc a:hover { color: var(--teal); }

    /* ── FEATURE TABLE ── */
    .feat-table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 10px;
      margin: 1.25rem 0;
      -webkit-overflow-scrolling: touch;
    }

    .feat-table {
      width: 100%;
      min-width: 480px;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    .feat-table thead tr { background: var(--paper-warm); }

    .feat-table th {
      padding: 0.7rem 1rem;
      text-align: left;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-soft);
      border-bottom: 2px solid var(--border);
      white-space: nowrap;
    }

    .feat-table td {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--border);
      color: var(--ink-mid);
      vertical-align: top;
    }

    .feat-table tbody tr:last-child td { border-bottom: none; }
    .feat-table tbody tr:hover { background: var(--paper-warm); }

    .badge-yes {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      background: var(--green-pale);
      color: var(--green);
      border: 1px solid #bbf7d0;
      border-radius: 5px;
      padding: 0.12rem 0.5rem;
      font-size: 0.78rem;
      font-weight: 700;
    }

    .badge-no {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      background: var(--red-pale);
      color: var(--red);
      border: 1px solid #fecaca;
      border-radius: 5px;
      padding: 0.12rem 0.5rem;
      font-size: 0.78rem;
      font-weight: 700;
    }

    .badge-partial {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      background: var(--amber-light);
      color: #92400e;
      border: 1px solid #fde68a;
      border-radius: 5px;
      padding: 0.12rem 0.5rem;
      font-size: 0.78rem;
      font-weight: 700;
    }

    /* ── STEP BOXES ── */
    .step-list {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin: 1.25rem 0;
    }

    .step-item {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }

    .step-num {
      width: 28px;
      height: 28px;
      background: var(--ink);
      color: white;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-size: 0.8rem;
      font-weight: 700;
      flex-shrink: 0;
      margin-top: 1px;
    }

    .step-body strong {
      display: block;
      font-size: 0.95rem;
      color: var(--ink);
      margin-bottom: 0.2rem;
    }

    .step-body p {
      font-size: 0.92rem;
      color: var(--ink-soft);
      margin: 0;
    }

    /* ── SAMPLE TABLE ── */
    .sample-table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 10px;
      margin: 1.25rem 0;
      -webkit-overflow-scrolling: touch;
    }

    .sample-table {
      width: 100%;
      min-width: 520px;
      border-collapse: collapse;
      font-size: 0.88rem;
    }

    .sample-table thead tr { background: var(--paper-mid); }

    .sample-table th {
      padding: 0.65rem 0.85rem;
      text-align: left;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-soft);
      border-bottom: 2px solid var(--border);
      white-space: nowrap;
    }

    .sample-table td {
      padding: 0.65rem 0.85rem;
      border-bottom: 1px solid var(--border);
      color: var(--ink-mid);
      white-space: nowrap;
    }

    .sample-table tbody tr:last-child td { border-bottom: none; }
    .sample-table tbody tr:nth-child(even) { background: var(--paper-warm); }

    .tag-paid {
      background: var(--green-pale);
      color: var(--green);
      border: 1px solid #bbf7d0;
      border-radius: 4px;
      padding: 0.1rem 0.45rem;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .tag-pending {
      background: var(--red-pale);
      color: var(--red);
      border: 1px solid #fecaca;
      border-radius: 4px;
      padding: 0.1rem 0.45rem;
      font-size: 0.75rem;
      font-weight: 700;
    }

    /* ── MID-ARTICLE CTA ── */
    .inline-cta {
      background: var(--paper-warm);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      margin: 2rem 0;
      display: flex;
      gap: 1rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .inline-cta-text {
      flex: 1;
      min-width: 200px;
    }

    .inline-cta-text strong {
      display: block;
      font-size: 0.95rem;
      color: var(--ink);
      margin-bottom: 0.2rem;
    }

    .inline-cta-text p {
      font-size: 0.85rem;
      color: var(--ink-soft);
      margin: 0;
    }

    .btn-teal {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--teal);
      color: white !important;
      text-decoration: none !important;
      padding: 0.6rem 1.2rem;
      border-radius: 7px;
      font-size: 0.88rem;
      font-weight: 700;
      white-space: nowrap;
      transition: background 0.15s;
      flex-shrink: 0;
    }
    .btn-teal:hover { background: var(--teal-dark); }

    .btn-dark-lg {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      background: var(--ink);
      color: white !important;
      text-decoration: none !important;
      padding: 0.85rem 1.5rem;
      border-radius: 9px;
      font-size: 0.97rem;
      font-weight: 700;
      transition: transform 0.15s, box-shadow 0.15s;
      box-shadow: 0 4px 14px rgba(26,26,26,0.2);
    }
    .btn-dark-lg:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(26,26,26,0.28);
    }

    .btn-full { width: 100%; }

    /* ── SK FEATURE BOX ── */
    .sk-box {
      background: var(--ink);
      border-radius: 14px;
      padding: 2rem;
      margin: 2.5rem 0;
      color: white;
    }

    .sk-box-header {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .sk-logo-mark {
      width: 42px;
      height: 42px;
      background: #f59e0b;
      border-radius: 10px;
      display: grid;
      place-items: center;
      font-family: var(--serif);
      font-weight: 900;
      font-size: 0.85rem;
      color: var(--ink);
      flex-shrink: 0;
    }

    .sk-box-title {
      font-family: var(--serif);
      font-size: 1.2rem;
      font-weight: 900;
      color: white;
      line-height: 1.25;
    }

    .sk-box-sub {
      font-size: 0.85rem;
      color: rgba(255,255,255,0.6);
      margin-top: 0.2rem;
    }

    .sk-features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
      margin-bottom: 1.5rem;
    }

    .sk-feat {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.87rem;
      color: rgba(255,255,255,0.85);
    }

    .sk-feat::before {
      content: '✓';
      color: #f59e0b;
      font-weight: 800;
      flex-shrink: 0;
    }

    .sk-box-cta {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn-amber-lg {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #f59e0b;
      color: var(--ink) !important;
      text-decoration: none !important;
      padding: 0.8rem 1.5rem;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 800;
      transition: transform 0.15s, box-shadow 0.15s;
      box-shadow: 0 4px 14px rgba(245,158,11,0.35);
    }
    .btn-amber-lg:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(245,158,11,0.5);
    }

    .sk-box-note {
      font-size: 0.8rem;
      color: rgba(255,255,255,0.4);
    }

    /* ── FAQ ── */
    .faq-section { margin: 2rem 0; }

    .faq-section h2 {
      font-family: var(--serif);
      font-size: 1.35rem;
      font-weight: 900;
      color: var(--ink);
      margin-bottom: 1.25rem;
    }

    details.faq-item {
      border-bottom: 1px solid var(--border);
      padding: 0.9rem 0;
    }

    details.faq-item:last-of-type { border-bottom: none; }

    summary.faq-q {
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
